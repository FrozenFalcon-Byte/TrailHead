# Copy to .env and fill in. .env is git-ignored; never commit keys.

# --- Jev (decision engine) -------------------------------------------------
# Set the key for every provider you have. Trailhead pools all of them and
# sends each request to whichever has a free rate-limit slot first.
TYPESAFE_API_KEY=        # direct: console.typesafe.ai ($5 signup credit when signups are open)
AI_GATEWAY_API_KEY=      # Vercel AI Gateway: monthly free credit, model typesafe-ai/jev
BEATAPI_API_KEY=         # BeatAPI: jev-1.13-free, 1 req/min (10/min after any top-up)
OPENROUTER_API_KEY=      # OpenRouter: paid, $0.042 per 1M input tokens

# Optional per-provider overrides (NAME = TYPESAFE | VERCEL | BEATAPI | OPENROUTER)
# JEV_BEATAPI_RPM=10
# JEV_VERCEL_RPM=8
# JEV_VERCEL_MODEL=typesafe-ai/jev
# JEV_PROVIDER_ORDER=typesafe,vercel,beatapi,openrouter

# --- LLM (prose + LLMFallbackEngine), any OpenAI-compatible endpoint --------
LLM_API_KEY=             # your Groq key
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
LLM_RPM=20

# --- General ---------------------------------------------------------------
DECISION_ENGINE=jev      # jev | llm
# GITHUB_TOKEN=          # optional; falls back to `gh auth token`
# TRAILHEAD_DATA_DIR=data
